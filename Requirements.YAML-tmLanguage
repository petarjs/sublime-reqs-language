# [PackageDev] target_format: plist, ext: tmLanguage
---
name: Reqs
scopeName: text.requirements
fileTypes: [reqs, requirements]
uuid: 94273595-e914-4678-8e7d-0b99e9a03ff5

patterns:
# milestone
- name: constant.language
  match: ^\[.*\]

# project description delimiter
- name: keyword.operator.word
  match: ^---\s*$

# title, with metadata on the same line still highlighted
- name: keyword.operator.word
  begin: ^\s*-(?=\s)
  end: $
  patterns:
  - include: '#metadata'

- include: '#metadata'

# comment date time
- name: variable.language
  match: \(.*\)

repository:
  metadata:
    patterns:
    # custom variable
    - name: storage.type
      match: (--[^\s]+){1}

    # tags and numbers
    - name: entity.name
      match: \#[^\s]*

    # mentions
    - name: variable.language
      match: \@[^\s]*
